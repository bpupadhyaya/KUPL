// Capabilities as attenuable values (it116-it118) — see docs/design/CAPABILITIES.md.
//
//   cap_net_root() / cap_fs_root()      -> CapNet / CapFs (the UNRESTRICTED root)
//   cap.limited_to(scope: Str)          -> CapNet / CapFs (a NARROWER capability; NEVER widens)
//   http_get_with(cap, url)             -> Result[Str, Str]
//   read_file_with(cap, path)           -> Result[Str, Str]
//
// A capability is an opaque runtime value: it cannot be pattern-matched into
// or constructed from a literal, only obtained from a root builtin and
// narrowed from there. `http_get_with`/`read_file_with` check the target
// against the capability's own carried scope BEFORE ever reaching the
// network/disk — an out-of-scope target is rejected locally, `curl`/the
// filesystem is never even touched.
//
// Root capabilities are seeded at EXACTLY one place: `cap_net_root()` and
// `cap_fs_root()` may only be called directly in `fun main`'s own top-level
// body (a top-level helper, a component method, or even a closure literal
// written directly inside `main` are all refused at compile time, K0304) —
// so "a capability is in scope" is a purely lexical, audit-by-reading-the-
// props property everywhere below the entry point.
//
// This file makes NO real network call or filesystem access by default (so
// it's safe for the interp-vs-vm/interp-vs-native sweep) — pass a URL to
// actually fetch it:
//   kupl run examples/capabilities.kupl -- https://example.com/

component TodoStore {
    intent "Fetches todos, scoped to exactly one host."
    requires net: CapNet

    expose fun sync() uses io.net -> Result[Str, Str] {
        http_get_with(net, "http://not-the-allowed-host.invalid/todos")
    }
}

component ConfigReader {
    intent "Reads a config file, scoped to exactly one directory."
    requires fs: CapFs

    expose fun read() uses io.fs -> Result[Str, Str] {
        read_file_with(fs, "/etc/not-the-allowed-dir/config.toml")
    }
}

fun main() uses io, io.net, io.fs {
    let net_root = cap_net_root()
    print(net_root)

    let net_scoped = net_root.limited_to("api.example.com")
    print(net_scoped)

    // re-limiting to the SAME host is a no-op, not a widen error.
    print(net_scoped.limited_to("api.example.com"))

    // the capability narrows what the ALREADY-granted `io.net` effect can
    // reach: a component holding `net_scoped` cannot fetch from a
    // DIFFERENT host, even though it fully declares `uses io.net`.
    let store = TodoStore(net_scoped)
    match store.sync() {
        Ok(_) => print("fetched (unexpected — host should have been blocked)")
        Err(e) => print("blocked as expected: {e}")
    }

    // CapFs is the SAME pattern, generalized to a second capability kind
    // (it118) — an opaque type, `.limited_to`, and a `_with`-suffixed
    // builtin, all sharing the SAME root-seeding restriction (K0304).
    let fs_root = cap_fs_root()
    print(fs_root)

    let fs_scoped = fs_root.limited_to("/etc/allowed-dir")
    print(fs_scoped)

    let reader = ConfigReader(fs_scoped)
    match reader.read() {
        Ok(_) => print("read (unexpected — path should have been blocked)")
        Err(e) => print("blocked as expected: {e}")
    }

    let urls = args()
    if urls.is_empty() {
        print("(pass a URL as an arg to see a real fetch through a MATCHING-host capability)")
    } else {
        // an UNRESTRICTED root capability, so any URL the caller actually
        // passed in is reachable — narrowing to the exact matching host
        // is exactly what `TodoStore` above already demonstrated.
        for url in urls {
            match http_get_with(net_root, url) {
                Ok(body) => print("{url} -> {body.len()} bytes")
                Err(e) => print("{url} -> error: {e}")
            }
        }
    }
}
